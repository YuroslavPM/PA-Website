@{
    Layout = "_Layout";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Course",
        "name": "Пътешествие към себе си",
        "description": "8 седмична програма по терапевтично писане.",
        "provider": {
            "@@type": "Person",
            "name": "Мариела Разпопова"
        },
        "offers": {
            "@@type": "Offer",
            "price": "150",
            "priceCurrency": "EUR"
        }
    }
    </script>
}

@section Styles {
    <style>
        .btn-gradient {
            background: linear-gradient(135deg, #4a0e78, #6a3093);
            box-shadow: 0 4px 6px rgba(106, 48, 147, 0.2);
        }

        .btn-gradient:hover {
            background: linear-gradient(135deg, #6a3093, #4a0e78);
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(106, 48, 147, 0.3);
        }
    </style>
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden relative">
            <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-purple-500 via-primary to-secondary z-10"></div>
            <div class="h-56 sm:h-80 overflow-hidden">
                <img src="/Images/siteImg/program-writing.png"
                     alt="Пътешествие към себе си — терапевтично писане"
                     class="w-full h-full object-cover"
                     width="1200" height="800" />
            </div>
            <div class="px-6 sm:px-10 py-10">
                <h1 class="font-playfair text-3xl sm:text-5xl font-bold text-primary mb-3 relative inline-block">
                    Пътешествие към себе си
                    <div class="absolute bottom-0 left-0 w-24 h-1.5 bg-gradient-to-r from-primary to-secondary rounded-full"></div>
                </h1>
                <p class="text-lg sm:text-xl text-secondary font-medium mt-4 mb-8">8 седмична програма по терапевтично писане</p>

                <div class="space-y-5 text-gray-700 leading-relaxed text-lg">
                    <p><em>„Пътешествие към себе си”</em> е цялостна авторска програма, основана на <strong>терапевтичното писане</strong> като инструмент за себепознание и личностно развитие. Тя те води през различни психологически и екзистенциални теми, за да видиш собственото си отражение между редовете. В това пътешествие ще срещаш приказни образи, метафори, митове, философски идеи и различни литературни форми на изразяване. <strong>Не е нужно да имаш опит в писането</strong>, нито пък специфични литературни умения за изразяване върху белия лист. Нужно е единствено да носиш <em>любопитството си</em> и готовността да си отделиш време за среща със себе си.</p>
                    <p>Програмата е създадена по такъв начин, че да улесни всеки да върви в <strong>собствения си ритъм</strong> и същевременно да разчита на професионална подкрепа и насока по време на целия процес.</p>
                </div>

                <h2 class="font-playfair text-2xl font-bold text-primary mt-10 mb-4 relative pb-2">
                    Как протича програмата?
                    <div class="absolute bottom-0 left-0 w-16 h-1 bg-gradient-to-r from-primary to-secondary rounded-full"></div>
                </h2>
                <div class="space-y-5 text-gray-700 leading-relaxed text-lg">
                    <p>Всяка седмица в продължение на два месеца ще получаваш своята <strong>седмична практика</strong>, която ще можеш да изпълниш в удобно за теб време и пространство. Всяка от тези практики е насочена към различен аспект от вътрешния свят и е придружена от ясни инструкции и въпроси за размисъл.</p>
                    <p>След като изпълниш упражнението, ако желаеш, можеш да ми изпратиш написаното. <strong>Аз лично</strong> ще се запозная с текстовете ти и ще ти върна <strong>писмена обратна връзка</strong> върху споделеното от теб, с наблюдения и насоки за по-дълбоко изследване. Споделянето на текстовете <em>не е задължително</em>, а е възможност, която можеш да използваш според собственото си усещане за комфорт и готовност.</p>
                    <p>В началото на програмата ще проведем кратка онлайн опознавателна среща (с продължителност <strong>30 минути</strong>), на която ще се запознаем, ще обсъдим очакванията ти и ще поставим фокус на предстоящия процес.</p>
                    <p>След приключването на осемте седмици ще се срещнем отново в индивидуална онлайн сесия (с продължителност <strong>50 минути</strong>), посветена на осмислянето и интегрирането на извървения път, на прозренията и промените, които са се появили по време на програмата.</p>
                </div>

                <h2 class="font-playfair text-2xl font-bold text-primary mt-10 mb-4 relative pb-2">
                    Теми, които ще изследваме:
                    <div class="absolute bottom-0 left-0 w-16 h-1 bg-gradient-to-r from-primary to-secondary rounded-full"></div>
                </h2>
                <p class="text-gray-700 mb-4 text-lg">Сред темите, с които ще работим, са:</p>
                <ul class="list-disc pl-6 space-y-2 text-gray-700 text-lg">
                    <li>представата за себе си и личната идентичност;</li>
                    <li>самочувствието и вътрешният критик;</li>
                    <li>личните ресурси и силните страни;</li>
                    <li>връзката с тялото и вътрешния глас;</li>
                    <li>приемането на собствената сянка и противоречивите части от нас;</li>
                    <li>емоциите и позволението да ги преживяваме;</li>
                    <li>вътрешната свобода и личната отговорност;</li>
                    <li>смисълът, изборите и начинът, по който искаме да живеем живота си.</li>
                </ul>

                <h2 class="font-playfair text-2xl font-bold text-primary mt-10 mb-4 relative pb-2">
                    Защо терапевтичното писане?
                    <div class="absolute bottom-0 left-0 w-16 h-1 bg-gradient-to-r from-primary to-secondary rounded-full"></div>
                </h2>
                <p class="text-gray-700 mb-4 text-lg">Писането има своите освобождаващи функции, сред които:</p>
                <ul class="list-disc pl-6 space-y-2 text-gray-700 text-lg">
                    <li>Създава доверително пространство за теб (бялата страница).</li>
                    <li>Свързва те с емоционалното ти състояние и позволява да свалиш напрежението.</li>
                    <li>Позволява ти да експериментираш и да създаваш оригинални решения.</li>
                    <li>Действа като пространство за изясняване на мислите. Пишейки, подреждаш мислите си. Прочитайки ги, обикновено се отваря една скрита порта.</li>
                    <li>То е трамплин да си позволиш да поставиш на сцената вътрешния си свят и е мост към себе си и към другите.</li>
                    <li>Подобно на сънуването, писането може да ни срещне с образи, чувства и идеи, които не винаги достигат до нас по пътя на рационалното мислене.</li>
                    <li>Предлага възможността да откриеш нещо, което е било скрито и се появява по време на или в края на процеса.</li>
                    <li>Писането може да има благоприятен ефект върху психическото и физическото ни благополучие.</li>
                    <li>Позволява трансформирането на обсесии и вътрешните фантазми в творчески материал.</li>
                </ul>

                <h2 class="font-playfair text-2xl font-bold text-primary mt-10 mb-4 relative pb-2">
                    За кого е подходяща тази програма?
                    <div class="absolute bottom-0 left-0 w-16 h-1 bg-gradient-to-r from-primary to-secondary rounded-full"></div>
                </h2>
                <div class="space-y-5 text-gray-700 leading-relaxed text-lg">
                    <p>Програмата не поставя ограничение във възраст и пол. Всеки, който е готов да се срещне с части от своята душевна мозайка е добре дошъл на това пътешествие. Това не е програма, която обещава готови отговори. Тя е покана да зададеш своите въпроси, да чуеш по-внимателно вътрешния си глас и да откриеш собствените си отговори.</p>
                    <p>Независимо дали преминаваш през бурни промени в настоящия момент или искаш да си подариш качествено време за себе си, подхранвайки връзката с вътрешния си свят, тази авторска осемседмична програма по терапевтичното писане ти предоставя възможност да се гмурнеш надълбоко по един мил начин.</p>
                </div>

                <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-white border-2 border-primary/20 shadow-lg text-center">
                    <p class="text-sm uppercase tracking-widest text-primary font-semibold mb-2">Цена за участие</p>
                    <p class="font-playfair text-5xl sm:text-6xl font-bold text-primary leading-none">150 €</p>
                    <p class="text-gray-600 mt-3 text-base sm:text-lg">заплатени преди старта</p>
                </div>

                <div class="mt-6 p-6 sm:p-8 rounded-2xl bg-secondary/5 border border-secondary/10">
                    <h2 class="font-playfair text-2xl font-bold text-primary mb-4">Участие:</h2>
                    <p class="text-gray-700 leading-relaxed text-lg mb-6">
                        За да се включиш в <em>„Пътешествие към себе си”</em> можеш да се свържеш с мен на имейл
                        <a class="text-primary font-medium underline" href="mailto:@SitePathCatalog.ProgramEmail">@SitePathCatalog.ProgramEmail</a>.
                        Програмата <strong>не замества психотерапия или психологическо консултиране</strong> и не е предназначена за работа с остри психични състояния.
                    </p>
                    <a href="mailto:@SitePathCatalog.ProgramEmail?subject=Пътешествие към себе си"
                       class="inline-flex items-center btn-gradient text-white px-8 py-4 rounded-full font-medium transition-all duration-300">
                        <i class="fas fa-envelope mr-3"></i>
                        Пиши ми за участие
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
