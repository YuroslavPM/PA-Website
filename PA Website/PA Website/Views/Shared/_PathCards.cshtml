@model IEnumerable<PathCard>

<div class="path-cards">
    @foreach (var card in Model)
    {
        <a href="@card.Url" class="path-card group">
            <div class="path-card-image">
                @if (!string.IsNullOrEmpty(card.ImagePath))
                {
                    <img src="@card.ImagePath" alt="@card.Title"
                         loading="lazy" decoding="async" width="320" height="140"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                }
                else
                {
                    <div class="h-full bg-gradient-to-br from-purple-100 to-indigo-100 flex items-center justify-center">
                        <i class="fas fa-compass text-3xl text-[#4c1d95] opacity-50"></i>
                    </div>
                }
            </div>
            <div class="path-card-body">
                <h3>@card.Title</h3>
                <p>@card.Description</p>
                <span class="path-card-link">
                    Научи повече
                    <i class="fas fa-arrow-right"></i>
                </span>
            </div>
        </a>
    }
</div>

<style>
    .path-cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .path-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        background: #fff;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 8px 24px -12px rgba(76, 29, 149, 0.25);
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

    .path-card:hover {
        box-shadow: 0 16px 32px -12px rgba(76, 29, 149, 0.35);
        transform: translateY(-3px);
    }

    .path-card-image {
        height: 8.5rem;
        overflow: hidden;
    }

    .path-card-body {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.9rem 1rem 1rem;
        flex: 1;
    }

    .path-card-body h3 {
        margin: 0;
        color: #4c1d95;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .path-card-body p {
        margin: 0;
        color: #4b5563;
        font-size: 0.875rem;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .path-card-link {
        margin-top: auto;
        padding-top: 0.35rem;
        color: #4c1d95;
        font-weight: 600;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .path-card:hover .path-card-link {
        color: #7c3aed;
    }

    @@media (min-width: 700px) {
        .path-cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1024px) {
        .path-cards {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .path-card-image {
            height: 7.5rem;
        }
    }
</style>
