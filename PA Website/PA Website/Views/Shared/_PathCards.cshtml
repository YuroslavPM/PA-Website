@model IEnumerable<PathCard>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
    @foreach (var card in Model)
    {
        <a href="@card.Url" class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 block group focus-visible:focus">
            <div class="h-48 sm:h-56 overflow-hidden">
                @if (!string.IsNullOrEmpty(card.ImagePath))
                {
                    <img src="@card.ImagePath" alt="@card.Title"
                         loading="lazy" decoding="async" width="400" height="224"
                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                }
                else
                {
                    <div class="h-full bg-gradient-to-br from-purple-100 to-indigo-100 flex items-center justify-center">
                        <i class="fas fa-compass text-3xl sm:text-4xl text-primary opacity-50"></i>
                    </div>
                }
            </div>
            <div class="p-4 sm:p-6">
                <h3 class="text-lg sm:text-xl font-bold text-primary mb-2 sm:mb-3">@card.Title</h3>
                <p class="text-gray-600 mb-3 sm:mb-4 text-sm sm:text-base">@card.Description</p>
                <div class="inline-flex items-center text-primary group-hover:text-secondary font-medium transition-colors duration-300 text-sm sm:text-base">
                    Научи повече
                    <i class="fas fa-arrow-right ml-2"></i>
                </div>
            </div>
        </a>
    }
</div>
